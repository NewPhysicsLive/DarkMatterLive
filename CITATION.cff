    email: brij@cern.ch
    affiliation: Rutherford Appleton Laboratory, UK
license: Apache-2.0
url: https://darkmatter.web.cern.ch
repository-code: https://github.com/NewPhysicsLive/DarkMatterLive
keywords:
  - dark matter
  - constraints
  - exclusion limits
  - particle physics
  - cosmology
  - data visualisation
